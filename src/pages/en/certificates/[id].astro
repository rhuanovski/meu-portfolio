---
import { ArrowLeft, ArrowUpRight, Check } from "lucide-react";
import { getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const certificate = Astro.params.id
  ? await getEntry("certificatesEn", Astro.params.id)
  : undefined;

if (!certificate || certificate.data.draft) {
  return Astro.redirect("/en/404");
}

const { data } = certificate;
const { Content } = await render(certificate);
const formattedDate = new Intl.DateTimeFormat("en-US", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(data.publishedAt);
const origin = Astro.site ?? Astro.url.origin;
const certificateSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalCredential",
  name: data.title,
  description: data.description,
  dateCreated: data.publishedAt.toISOString(),
  credentialCategory: "Certificate",
  inLanguage: "en",
  recognizedBy: {
    "@type": "Organization",
    name: data.issuer,
  },
  url: new URL(`/en/certificates/${certificate.id}`, origin).toString(),
  sameAs: data.credentialUrl,
};
---

<BaseLayout
  locale="en"
  title={data.title}
  description={data.description}
  image={data.image}
  jsonLd={certificateSchema}
>
  <header class="container detail-hero">
    <a class="text-link" href="/en/journey#certifications">
      <ArrowLeft size={17} strokeWidth={1.9} />
      All certifications
    </a>
    <div class="detail-kicker" style="margin-top:34px">
      <span>{data.issuer}</span>
      <span>•</span>
      <time datetime={data.publishedAt.toISOString()}>{formattedDate}</time>
    </div>
    <h1 class="detail-title">{data.title}</h1>
    <p class="detail-description">{data.description}</p>
    <div class="tag-list">
      {data.skills.map((skill) => <span class="tag">{skill}</span>)}
    </div>
    {
      data.credentialUrl && (
        <div class="button-row">
          <a
            class="button button-accent"
            href={data.credentialUrl}
            target="_blank"
            rel="noreferrer"
          >
            Verify credential
            <ArrowUpRight size={17} strokeWidth={1.9} />
          </a>
        </div>
      )
    }
    {
      data.image && (
        <figure class="detail-media">
          <img
            src={data.image}
            alt={`Certificate for ${data.title}`}
            width="1600"
            height="900"
            decoding="async"
          />
        </figure>
      )
    }
  </header>

  <section class="section section-compact">
    <div class="container detail-layout">
      <article class="prose">
        <Content />
      </article>
      <aside class="detail-aside" aria-label="Certification summary">
        <div class="aside-block">
          <p class="aside-label">Issuer</p>
          <ul class="aside-list">
            <li>{data.issuer}</li>
          </ul>
        </div>
        <div class="aside-block">
          <p class="aside-label">Skills</p>
          <ul class="aside-list">
            {data.skills.map((skill) => (
              <li style="display:flex;gap:8px;align-items:flex-start">
                <Check
                  size={15}
                  strokeWidth={2}
                  color="var(--violet)"
                  style={{ marginTop: "3px", flex: "0 0 auto" }}
                />
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
