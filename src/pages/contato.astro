---
import { ArrowUpRight, GithubIcon, LinkedinIcon, Mail, MessageCircle, Send } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contato"
  description="Entre em contato com Rhuan Carlos para projetos, oportunidades e colaborações em software e engenharia."
>
  <header class="container page-hero">
    <p class="eyebrow">Contato</p>
    <h1 class="page-title">Vamos construir algo bom.</h1>
    <p class="lede">
      Conte um pouco sobre o problema, a oportunidade ou a ideia. Quanto mais
      contexto, melhor será a primeira conversa.
    </p>
  </header>

  <section class="section section-compact">
    <div class="container contact-grid">
      <aside class="contact-panel contact-panel-dark">
        <p class="eyebrow" style="color:#c4b2ff">Canais diretos</p>
        <h2>Escolha onde prefere conversar.</h2>
        <p>
          Para projetos, colaborações, pesquisa aplicada ou oportunidades profissionais.
        </p>
        <div class="contact-links">
          <a class="contact-link" href={`mailto:${site.email}`}>
            <span style="display:flex;align-items:center;gap:10px"><Mail size={17} /> E-mail</span>
            <ArrowUpRight size={16} />
          </a>
          <a class="contact-link" href={site.whatsapp} target="_blank" rel="noreferrer">
            <span style="display:flex;align-items:center;gap:10px"><MessageCircle size={17} /> WhatsApp</span>
            <ArrowUpRight size={16} />
          </a>
          <a class="contact-link" href={site.linkedin} target="_blank" rel="noreferrer">
            <span style="display:flex;align-items:center;gap:10px"><LinkedinIcon size={17} /> LinkedIn</span>
            <ArrowUpRight size={16} />
          </a>
          <a class="contact-link" href={site.github} target="_blank" rel="noreferrer">
            <span style="display:flex;align-items:center;gap:10px"><GithubIcon size={17} /> GitHub</span>
            <ArrowUpRight size={16} />
          </a>
        </div>
      </aside>

      <div class="contact-panel">
        <form
          class="form-grid"
          action={`https://formsubmit.co/${site.email}`}
          method="POST"
        >
          <input type="hidden" name="_subject" value="Novo contato pelo portfólio" />
          <input type="hidden" name="_template" value="table" />
          <input class="hidden-field" type="text" name="_honey" tabindex="-1" autocomplete="off" />

          <div class="field">
            <label for="name">Seu nome</label>
            <input id="name" name="name" type="text" autocomplete="name" required placeholder="Como posso chamar você?" />
          </div>
          <div class="field">
            <label for="email">Seu e-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="voce@exemplo.com" />
          </div>
          <div class="field">
            <label for="subject">Assunto</label>
            <input id="subject" name="subject" type="text" required placeholder="Projeto, oportunidade ou colaboração" />
          </div>
          <div class="field">
            <label for="message">Mensagem</label>
            <textarea id="message" name="message" required placeholder="Conte o contexto e como posso ajudar."></textarea>
          </div>
          <button class="button button-accent" type="submit">
            Enviar mensagem
            <Send size={16} strokeWidth={1.9} />
          </button>
        </form>
        <p class="form-note">
          Ao enviar, a mensagem será encaminhada diretamente para {site.email}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
