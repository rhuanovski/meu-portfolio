---
import { GithubIcon, LinkedinIcon, Mail, Menu, X } from "lucide-react";
import { navigation, site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, página inicial`}>
      <span class="brand-mark" aria-hidden="true">RC</span>
      <span>{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      {
        navigation.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-link" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub de Rhuan Carlos">
        <GithubIcon size={17} strokeWidth={1.8} />
      </a>
      <a class="icon-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn de Rhuan Carlos">
        <LinkedinIcon size={17} strokeWidth={1.8} />
      </a>
      <a class="button button-primary" href="/contato">
        <Mail size={16} strokeWidth={1.9} />
        Fale comigo
      </a>

      <details class="mobile-menu">
        <summary aria-label="Abrir menu">
          <span class="menu-icon"><Menu size={19} strokeWidth={1.8} /></span>
          <span class="close-icon"><X size={19} strokeWidth={1.8} /></span>
        </summary>
        <div class="mobile-menu-panel">
          <nav aria-label="Navegação mobile">
            {
              navigation.map((item) => (
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="mobile-menu-actions">
            <a class="button button-secondary" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
            <a class="button button-secondary" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="button button-accent" href="/contato">Fale comigo</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
