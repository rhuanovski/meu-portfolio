---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";

interface Props {
  project: CollectionEntry<"projects"> | CollectionEntry<"projectsEn">;
  locale?: Locale;
}

const { project, locale = "pt" } = Astro.props;
const { data } = project;
const isEnglish = locale === "en";
const initials = data.title
  .split(" ")
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
---

<article class:list={["project-card", `accent-${data.accent}`]}>
  <div class="project-visual">
    {
      data.image ? (
        <img src={data.image} alt={data.imageAlt ?? ""} loading="lazy" decoding="async" />
      ) : (
        <div class="project-visual-placeholder" aria-hidden="true">
          <span class="project-monogram">{initials}</span>
        </div>
      )
    }
  </div>
  <div class="project-content">
    <div class="project-meta">
      <span>{data.eyebrow}</span>
      <span class="meta-dot">{data.status}</span>
    </div>
    <h3 class="project-title">{data.title}</h3>
    <p class="project-description">{data.description}</p>
    <div class="tag-list" aria-label={isEnglish ? "Technologies" : "Tecnologias"}>
      {data.stack.slice(0, 5).map((technology) => <span class="tag">{technology}</span>)}
    </div>
  </div>
  <a
    class="card-link"
    href={isEnglish ? `/en/projects/${project.id}` : `/projetos/${project.id}`}
    aria-label={isEnglish ? `View project ${data.title}` : `Ver projeto ${data.title}`}
  ></a>
</article>
