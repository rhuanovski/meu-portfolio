---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const initials = data.title
  .split(" ")
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
---

<article class:list={["project-card", `accent-${data.accent}`]}>
  <div class="project-visual">
    {
      data.image ? (
        <img src={data.image} alt={data.imageAlt ?? ""} loading="lazy" decoding="async" />
      ) : (
        <div class="project-visual-placeholder" aria-hidden="true">
          <span class="project-monogram">{initials}</span>
        </div>
      )
    }
  </div>
  <div class="project-content">
    <div class="project-meta">
      <span>{data.eyebrow}</span>
      <span class="meta-dot">{data.status}</span>
    </div>
    <h3 class="project-title">{data.title}</h3>
    <p class="project-description">{data.description}</p>
    <div class="tag-list" aria-label="Tecnologias">
      {data.stack.slice(0, 5).map((technology) => <span class="tag">{technology}</span>)}
    </div>
  </div>
  <a class="card-link" href={`/projetos/${project.id}`} aria-label={`Ver projeto ${data.title}`}></a>
</article>
