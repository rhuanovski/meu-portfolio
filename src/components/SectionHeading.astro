---
import { ArrowUpRight } from "lucide-react";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = "Ver todos" } = Astro.props;
---

<div class="section-head">
  <div class="section-head-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title">{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {
    href && (
      <a class="text-link" href={href}>
        {linkLabel}
        <ArrowUpRight size={17} strokeWidth={1.9} />
      </a>
    )
  }
</div>
